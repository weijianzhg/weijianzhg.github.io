source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'

group :jekyll_plugins do
  gem 'jekyll-archives'
  gem 'jekyll-feed'
  gem 'jekyll-paginate-v2'
  gem 'jekyll-sitemap'
end

# Used by _plugins/external-posts.rb to read the Substack feeds.
gem 'feedjira'
gem 'httparty'

# Needed by `jekyll serve` on Ruby 3+.
