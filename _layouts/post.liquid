<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page.title | escape }}
      | Weijian Zhang
    </title>
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ page.redirect | escape }}">
    <meta http-equiv="refresh" content="0; url={{ page.redirect | escape }}">
    <link rel="stylesheet" href="/assets/editorial/editorial.css">
  </head>
  <body>
    <div class="page editorial">
      <div class="page-wrap">
        <main class="subpage">
          <p class="redirect-note">
            This post now lives at <a class="text-link" href="{{ page.redirect | escape }}">{{ page.redirect | escape }}</a>
          </p>
        </main>
      </div>
    </div>
  </body>
</html>
