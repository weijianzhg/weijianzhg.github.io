#!/bin/bash

# Update feed cache, commit, and push to trigger a site rebuild.
# Usage: ./bin/publish-feeds

set -e

cd "$(dirname "$0")/.."

# Update feeds
./bin/update-feed-cache

# Check if anything changed
if git diff --quiet _cache/; then
  echo ""
  echo "ℹ️  No feed changes detected. Nothing to push."
  exit 0
fi

# Commit and push
git add _cache/
git commit -m "update feed"
git push

echo ""
echo "🚀 Feed updates committed and pushed. Deploy will trigger automatically."
